# 复制为 .env 后按需修改。切勿提交真实密钥。

# 数据库（自备 MySQL / MariaDB）
# Docker 访问宿主机数据库示例：
# DATABASE_URL=mysql+pymysql://user:pass@host.docker.internal:3306/zhange_stats
DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/zhange_stats

# JWT：可留空；首次启动会自动生成并写入 DATA_DIR/.secret_key
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS（逗号分隔；须写具体前端源。同域部署可省略；勿写 *，与 credentials 不兼容）
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# 首次启动种子管理员（仅当用户名不存在时创建；默认不会每次启动重置密码）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_DISPLAY_NAME=管理员
ADMIN_EMAIL=admin@localhost
# RESET_ADMIN_PASSWORD=true   # 仅排障时开启：启动时把种子管理员密码重置为 ADMIN_PASSWORD
# ENFORCE_SINGLE_ADMIN=true   # 仅需要时开启：启动时把其它管理员降级为普通用户

# Steam
STEAM_API_KEY=
STEAM_POLL_INTERVAL_MINUTES=3
STEAM_POLL_ENABLED=true
PUBLIC_BACKEND_URL=http://127.0.0.1:8000
PUBLIC_FRONTEND_URL=http://127.0.0.1:5173
# 运行时数据（密钥等，勿与公开静态目录混用）
DATA_DIR=data
UPLOAD_DIR=uploads

# 邮件（不配则验证码打印到服务端日志）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=true
SMTP_STARTTLS=false
EMAIL_CODE_EXPIRE_MINUTES=15

# —— 以下仅 Docker 部署可选 ——
APP_PORT=8080
APP_IMAGE=ghcr.io/739790797/zhange-stats
APP_TAG=latest
UPDATE_ENABLED=false
UPDATE_REPO=739790797/zhange-stats
UPDATE_GITHUB_TOKEN=
