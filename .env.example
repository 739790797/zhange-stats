# 数据库（MySQL / MariaDB）
DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/zhange_stats

# JWT
SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS（逗号分隔）
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# 首次启动种子管理员（若不存在则创建，勿在界面展示）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_DISPLAY_NAME=管理员
ADMIN_EMAIL=admin@localhost

# Steam 监控（API Key 勿提交到仓库）
STEAM_API_KEY=
STEAM_POLL_INTERVAL_MINUTES=3
STEAM_POLL_ENABLED=true
# Steam OpenID 绑定（回调必须能被浏览器访问到前后端）
PUBLIC_BACKEND_URL=http://127.0.0.1:8000
PUBLIC_FRONTEND_URL=http://127.0.0.1:5173
# 头像等本地上传目录（相对仓库根或绝对路径）
UPLOAD_DIR=uploads

# CS2 对局同步（暂未开放前端；默认关闭）
CS2_MATCH_POLL_ENABLED=false
CS2_MATCH_POLL_INTERVAL_MINUTES=15
CS2_MATCH_MAX_PER_MEMBER=20
CS2_GC_BOILER_PATH=
CS2_GC_FETCH_SCRIPT=
CS2_GC_TIMEOUT_SECONDS=90
CS2_GC_ENRICH_LIMIT=10

# 邮件（不配则验证码打印到后端控制台）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=true
SMTP_STARTTLS=false
EMAIL_CODE_EXPIRE_MINUTES=15
