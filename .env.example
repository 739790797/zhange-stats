# 数据库链接
DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/zhange_stats_dev
# APP_ENV=development  # 本地默认；Docker 镜像为 production（弱口令默认拒绝启动）
# 首次部署：浏览器打开站点，按安装向导创建管理员（无需 ADMIN_*）
# 仅 CI/脚本可自动种子：ALLOW_ENV_ADMIN_SEED=true 并填写下方 ADMIN_*
# ALLOW_ENV_ADMIN_SEED=true
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me-now
# ADMIN_DISPLAY_NAME=管理员
# ADMIN_EMAIL=admin@localhost
# 口令策略 / 单管理员 / 登录有效期：登录后在「安全设置」配置
# REDIS_URL=  # Docker 镜像默认 redis://127.0.0.1:6379/0（同容器内嵌）；本地可不设，走进程内降级
# 用途：限流 + 短时 KV（森空岛扫码 pending、cred 缓存等）。多 app 实例必须指向同一 Redis，否则扫码/cred 不互通；当前产品按单副本设计（见 README「部署形态」）
# EMBEDDED_REDIS=0  # 仅当镜像内不想起本机 Redis、改连外部时设 0，并配置 REDIS_URL
# TRUST_X_FORWARDED_FOR=true  # 仅受信反代后开启；默认 false，防伪造 XFF 绕过限流
# ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 默认 24 小时；也可在管理端「安全设置」调整
# ALLOW_EMAIL_CODE_LOG=true  # 仅本地调试；生产（APP_ENV=production）启动会拒绝

# OAuth 回调 / CORS 一般无需配置：
# - Docker 同域部署：按浏览器访问的 Host 自动推断
# - 本地 Vite：默认放行 localhost / 127.0.0.1 任意端口
# 特殊反代可选手动覆盖：
# CORS_ORIGINS=https://app.example.com
# PUBLIC_BACKEND_URL=https://app.example.com
# PUBLIC_FRONTEND_URL=https://app.example.com

# Docker部署
APP_PORT=8080
APP_IMAGE=ghcr.io/739790797/zhange-stats
APP_TAG=latest
# 更稳妥可钉版本，例如 APP_TAG=0.2.7（避免坏 latest 被 Watchtower 自动拉起）
# Watchtower 需挂载 docker.sock（宿主机 Docker 权限）；见 README
# Watchtower 轮询间隔（秒），默认 300
WATCHTOWER_POLL_INTERVAL=300
