# 数据库链接
DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/zhange_stats_dev
# APP_ENV=development  # 本地默认；LXC 生产用 production（弱口令默认拒绝启动）
# 首次部署：浏览器打开站点，按安装向导创建管理员（无需 ADMIN_*）
# 仅 CI/脚本可自动种子：ALLOW_ENV_ADMIN_SEED=true 并填写下方 ADMIN_*
# ALLOW_ENV_ADMIN_SEED=true
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me-now
# ADMIN_DISPLAY_NAME=管理员
# ADMIN_EMAIL=admin@localhost
# 口令策略 / 单管理员 / 登录有效期：登录后在「安全设置」配置
# REDIS_URL=redis://127.0.0.1:6379/0  # LXC 建议安装 redis-server；本地可不设，走进程内降级
# 用途：限流 + 短时 KV（森空岛扫码 pending、cred 缓存、塔科夫 join/大厅限流等）。多 app 实例必须指向同一 Redis；当前产品按单副本设计
# 公开引流前核对 docs/deploy.md「公开运营检查」
# 连接池（请求线程 + 调度任务共用；按 MariaDB max_connections 留余量）
# DB_POOL_SIZE=15
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=10
# TRUST_X_FORWARDED_FOR=true  # 仅受信反代后开启；默认 false，防伪造 XFF 绕过限流
# ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 默认 24 小时；也可在管理端「安全设置」调整
# ALLOW_EMAIL_CODE_LOG=true  # 仅本地调试；生产（APP_ENV=production）启动会拒绝

# OAuth 回调 / CORS 一般无需配置：
# - LXC 同域 / 反代：按浏览器访问的 Host 自动推断
# - 本地 Vite：默认放行 localhost / 127.0.0.1 任意端口
# - 战鸽助手（zhange-app / Tauri 2）：默认放行 https://tauri.localhost、tauri://localhost
# 特殊反代或额外壳源可选手动覆盖（CORS_ORIGINS 有值时不再用正则）：
# CORS_ORIGINS=https://app.example.com,https://tauri.localhost
# CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?|https://tauri\.localhost
# PUBLIC_BACKEND_URL=https://app.example.com
# PUBLIC_FRONTEND_URL=https://app.example.com

# ----- Linux LXC 源码部署（scripts/install.sh 会写入）-----
# APP_INSTALL_DIR=/opt/zhange-stats
# STATIC_DIR=/opt/zhange-stats/static
# DATA_DIR=/opt/zhange-stats/var/data
# UPLOAD_DIR=/opt/zhange-stats/var/uploads
# 已有安装若仍用 /opt/zhange-stats/data 与 uploads，保持原值即可；勿改到 backend/ 或 frontend/ 下
# ALLOW_IN_APP_UPDATE=  # 空：仅 production 允许管理端一键更新；true/false 可强制
# UPDATE_GITHUB_REPO=739790797/zhange-stats
# UPDATE_GITHUB_API=https://api.github.com
# UPDATE_GITHUB_TOKEN=  # 可选兜底；优先在管理端「集成密钥」配置（提高 GitHub API 限额）
# 国内可在管理端更新时填 proxy，或自行反代 api.github.com / github.com
# GAME_SCHEDULE_BASE_URL=https://gebc.lee-sikaha.cloudns.ch  # 活动日历上游（jacket-sikaha/game-schedule）
