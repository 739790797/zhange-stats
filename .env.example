# 数据库（MySQL / MariaDB）
DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/zhange_stats

# JWT
SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS（逗号分隔）
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# 首次启动种子管理员（若不存在则创建，勿在界面展示）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_DISPLAY_NAME=管理员
ADMIN_EMAIL=admin@localhost

# Steam 监控（API Key 勿提交到仓库）
STEAM_API_KEY=
STEAM_POLL_INTERVAL_MINUTES=3
STEAM_POLL_ENABLED=true

# 邮件（不配则验证码打印到后端控制台）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=true
SMTP_STARTTLS=false
EMAIL_CODE_EXPIRE_MINUTES=15
