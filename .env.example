# ========== 本地开发 / Docker 共用 ==========
# 复制为 .env 后按需修改。切勿提交真实密钥。

# 数据库（本地开发连本机 MySQL；Docker Compose 会覆盖为连 db 服务）
DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/zhange_stats

# JWT
SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS（逗号分隔；Docker 单端口同域可写 * 或你的站点 URL）
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# 首次启动种子管理员（若不存在则创建，勿在界面展示）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_DISPLAY_NAME=管理员
ADMIN_EMAIL=admin@localhost

# Steam 监控（API Key 勿提交到仓库）
STEAM_API_KEY=
STEAM_POLL_INTERVAL_MINUTES=3
STEAM_POLL_ENABLED=true
# Steam OpenID 绑定（回调必须能被浏览器访问到前后端）
# Docker 部署示例：http://192.168.x.x:8080 （LXC IP + APP_PORT）
PUBLIC_BACKEND_URL=http://127.0.0.1:8000
PUBLIC_FRONTEND_URL=http://127.0.0.1:5173
# 头像等本地上传目录（相对仓库根或绝对路径）
UPLOAD_DIR=uploads

# 邮件（不配则验证码打印到后端控制台）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=true
SMTP_STARTTLS=false
EMAIL_CODE_EXPIRE_MINUTES=15

# ========== Docker Compose 专用 ==========
# MySQL（compose 内 db 服务）
MYSQL_PASSWORD=zhange_change_me
MYSQL_ROOT_PASSWORD=root_change_me

# 应用对外端口（宿主机/LXC → 容器 8000）
APP_PORT=8080

# 镜像（GitHub Actions 推送到 GHCR）
APP_IMAGE=ghcr.io/739790797/zhange-stats
# 一键更新请保持 latest；发版后 Actions 会同时推 version 与 latest
APP_TAG=latest
# 仅本地 build 时使用；线上以镜像内版本为准
APP_VERSION=0.1.3

# 管理端「系统更新」
UPDATE_ENABLED=true
UPDATE_REPO=739790797/zhange-stats
# 私有仓库检查 Release 时可填 GitHub PAT（可选）
UPDATE_GITHUB_TOKEN=
