[Unit]
Description=Load binder_linux for Redroid / MAA
DefaultDependencies=no
After=local-fs.target
Before=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
# 模块包可能因发行版差异需先 apt install linux-modules-extra-$(uname -r)
ExecStart=/sbin/modprobe binder_linux devices=binder,hwbinder,vndbinder
ExecStartPost=/bin/sh -c 'mkdir -p /dev/binderfs 2>/dev/null || true'

[Install]
WantedBy=multi-user.target
