[Unit]
Description=Zhange Stats (战鸽数据)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zhange
Group=zhange
WorkingDirectory=/opt/zhange-stats/backend
EnvironmentFile=-/opt/zhange-stats/.env
Environment=APP_INSTALL_DIR=/opt/zhange-stats
Environment=STATIC_DIR=/opt/zhange-stats/static
Environment=APP_ENV=production
# DATA_DIR / UPLOAD_DIR 以 .env 为准（install.sh 写入）；勿在此写死以免盖掉已有路径
ExecStart=/opt/zhange-stats/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3
# 管理端一键更新：进程内落盘后 os.execv 同 PID 换码（AstrBot 式；无需 systemctl 权限）。
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
