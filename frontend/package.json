{
  "name": "frontend",
  "private": true,
  "version": "0.2.31",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "export:openapi": "cd ../backend && (if exist .venv\\Scripts\\python.exe (.venv\\Scripts\\python.exe scripts\\export_openapi.py) else (python scripts\\export_openapi.py))",
    "gen:api": "openapi-typescript ./src/api/generated/openapi.json -o ./src/api/generated/schema.d.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@ant-design/plots": "^2.6.8",
    "@tanstack/react-query": "^5.101.4",
    "antd": "^5.22.7",
    "axios": "^1.19.0",
    "dayjs": "^1.11.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.3",
    "openapi-typescript": "^7.10.1",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^3.2.7"
  }
}
